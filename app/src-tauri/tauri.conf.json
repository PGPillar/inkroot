{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Inkroot",
  "version": "0.1.3",
  "identifier": "io.github.n0dal.inkroot",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run stage && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Inkroot",
        "width": 880,
        "height": 640,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
